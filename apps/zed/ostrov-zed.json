{
  "$schema": "https://zed.dev/schema/themes/v0.2.0.json",
  "name": "ostrov",
  "author": "ostrov",
  "themes": [
    {
      "name": "ostrov",
      "appearance": "{{mode}}",
      "style": {
        "background": "{{bg}}",
        "surface.background": "{{sidebar}}",
        "elevated_surface.background": "{{view}}",
        "panel.background": "{{sidebar}}",
        "status_bar.background": "{{bar}}",
        "title_bar.background": "{{bar}}",
        "toolbar.background": "{{bg}}",
        "tab_bar.background": "{{sidebar}}",
        "tab.active_background": "{{bg}}",
        "tab.inactive_background": "{{sidebar}}",
        "editor.background": "{{bg}}",
        "editor.gutter.background": "{{bg}}",
        "editor.foreground": "{{fg}}",
        "editor.line_number": "{{dim}}",
        "editor.active_line_number": "{{accent}}",
        "editor.active_line.background": "{{card}}",
        "text": "{{fg}}",
        "text.muted": "{{dim}}",
        "text.accent": "{{accent}}",
        "border": "{{card}}",
        "border.variant": "{{card}}",
        "border.focused": "{{accent}}",
        "element.background": "{{card}}",
        "element.hover": "{{card}}",
        "element.selected": "{{card}}",
        "ghost_element.hover": "{{card}}",
        "ghost_element.selected": "{{card}}",
        "icon": "{{fg}}",
        "icon.muted": "{{dim}}",
        "icon.accent": "{{accent}}",
        "error": "{{urgent}}",
        "warning": "{{ansi3}}",
        "success": "{{ansi2}}",
        "info": "{{ansi4}}",
        "terminal.background": "{{bg}}",
        "terminal.foreground": "{{fg}}",
        "terminal.ansi.black": "{{ansi0}}",
        "terminal.ansi.red": "{{ansi1}}",
        "terminal.ansi.green": "{{ansi2}}",
        "terminal.ansi.yellow": "{{ansi3}}",
        "terminal.ansi.blue": "{{ansi4}}",
        "terminal.ansi.magenta": "{{ansi5}}",
        "terminal.ansi.cyan": "{{ansi6}}",
        "terminal.ansi.white": "{{ansi7}}",
        "terminal.ansi.bright_black": "{{ansi8}}",
        "terminal.ansi.bright_red": "{{ansi9}}",
        "terminal.ansi.bright_green": "{{ansi10}}",
        "terminal.ansi.bright_yellow": "{{ansi11}}",
        "terminal.ansi.bright_blue": "{{ansi12}}",
        "terminal.ansi.bright_magenta": "{{ansi13}}",
        "terminal.ansi.bright_cyan": "{{ansi14}}",
        "terminal.ansi.bright_white": "{{ansi15}}",
        "players": [{ "cursor": "{{accent}}", "background": "{{accent}}", "selection": "{{accent}}40" }],
        "syntax": {
          "comment": { "color": "{{dim}}", "font_style": "italic" },
          "string": { "color": "{{ansi2}}" },
          "keyword": { "color": "{{ansi5}}" },
          "function": { "color": "{{ansi4}}" },
          "type": { "color": "{{accent}}" },
          "constant": { "color": "{{ansi3}}" },
          "number": { "color": "{{ansi3}}" },
          "boolean": { "color": "{{ansi3}}" },
          "operator": { "color": "{{ansi6}}" },
          "property": { "color": "{{fg}}" },
          "variable": { "color": "{{fg}}" },
          "punctuation": { "color": "{{dim}}" },
          "title": { "color": "{{accent}}", "font_weight": 700 }
        }
      }
    }
  ]
}
