{
  "name": "ostrov",
  "type": "{{mode}}",
  "colors": {
    "editor.background": "{{bg}}",
    "editor.foreground": "{{fg}}",
    "editorLineNumber.foreground": "{{dim}}",
    "editorLineNumber.activeForeground": "{{accent}}",
    "editor.lineHighlightBackground": "{{card}}",
    "editor.selectionBackground": "{{accent}}55",
    "editorCursor.foreground": "{{accent}}",
    "sideBar.background": "{{sidebar}}",
    "sideBar.foreground": "{{fg}}",
    "activityBar.background": "{{bar}}",
    "activityBar.foreground": "{{fg}}",
    "activityBarBadge.background": "{{accent}}",
    "activityBarBadge.foreground": "{{ink}}",
    "titleBar.activeBackground": "{{bar}}",
    "titleBar.activeForeground": "{{fg}}",
    "statusBar.background": "{{bar}}",
    "statusBar.foreground": "{{fg}}",
    "tab.activeBackground": "{{bg}}",
    "tab.inactiveBackground": "{{sidebar}}",
    "tab.activeForeground": "{{fg}}",
    "tab.inactiveForeground": "{{dim}}",
    "editorGroupHeader.tabsBackground": "{{sidebar}}",
    "panel.background": "{{bg}}",
    "terminal.background": "{{bg}}",
    "terminal.foreground": "{{fg}}",
    "focusBorder": "{{accent}}",
    "button.background": "{{accent}}",
    "button.foreground": "{{ink}}",
    "list.activeSelectionBackground": "{{accent}}",
    "list.activeSelectionForeground": "{{ink}}",
    "list.hoverBackground": "{{card}}",
    "input.background": "{{view}}",
    "dropdown.background": "{{view}}",
    "editorWidget.background": "{{view}}",
    "terminal.ansiBlack": "{{ansi0}}", "terminal.ansiRed": "{{ansi1}}", "terminal.ansiGreen": "{{ansi2}}",
    "terminal.ansiYellow": "{{ansi3}}", "terminal.ansiBlue": "{{ansi4}}", "terminal.ansiMagenta": "{{ansi5}}",
    "terminal.ansiCyan": "{{ansi6}}", "terminal.ansiWhite": "{{ansi7}}", "terminal.ansiBrightBlack": "{{ansi8}}",
    "terminal.ansiBrightRed": "{{ansi9}}", "terminal.ansiBrightGreen": "{{ansi10}}", "terminal.ansiBrightYellow": "{{ansi11}}",
    "terminal.ansiBrightBlue": "{{ansi12}}", "terminal.ansiBrightMagenta": "{{ansi13}}", "terminal.ansiBrightCyan": "{{ansi14}}",
    "terminal.ansiBrightWhite": "{{ansi15}}"
  },
  "tokenColors": [
    { "scope": ["comment"], "settings": { "foreground": "{{dim}}", "fontStyle": "italic" } },
    { "scope": ["string"], "settings": { "foreground": "{{ansi2}}" } },
    { "scope": ["keyword", "storage"], "settings": { "foreground": "{{ansi5}}" } },
    { "scope": ["entity.name.function", "support.function"], "settings": { "foreground": "{{ansi4}}" } },
    { "scope": ["entity.name.type", "support.type", "storage.type"], "settings": { "foreground": "{{accent}}" } },
    { "scope": ["constant", "constant.numeric"], "settings": { "foreground": "{{ansi3}}" } },
    { "scope": ["keyword.operator"], "settings": { "foreground": "{{ansi6}}" } },
    { "scope": ["variable"], "settings": { "foreground": "{{fg}}" } }
  ]
}
