# ostrov from git's master: makepkg -si in this directory.
pkgname=ostrov-git
pkgver=0.1.0.r0.g0000000
pkgrel=1
pkgdesc='A whole desktop shell for Hyprland in one binary: bar, panels, launcher, notifications, lock screen and more'
arch=('x86_64' 'aarch64')
url='https://github.com/ostrov-shell/ostrov'
license=('MIT')
depends=('gtk4' 'gtk4-layer-shell' 'glib2' 'pam' 'wayland' 'pipewire' 'wireplumber')
makedepends=('git' 'cargo' 'pkgconf')
optdepends=('hyprland: the compositor ostrov is made for'
            'iwd: Wi-Fi'
            'networkmanager: Wi-Fi, in place of iwd'
            'bluez: Bluetooth'
            'upower: the battery'
            'power-profiles-daemon: the power modes, powerprofilesctl for the games plugin'
            'polkit: the polkit agent'
            'wf-recorder: screen recording (the plugin record)'
            'wl-clipboard: a recording's path on the clipboard (the plugin record)'
            'pipewire-pulse: screen recording with audio (the plugin record)'
            'udisks2: removable drives mounted and ejected (the plugin drives)'
            'pacman-contrib: the pending updates (the plugin updates, its checkupdates)'
            'fd: the launcher finding files'
            'kanshi: display profiles, applied as monitors are plugged in, listed by the displays plugin'
            'unicode-emoji: the launcher finding emoji'
            'gnome-keyring: secrets in the Secret Service')
provides=('ostrov')
conflicts=('ostrov')
backup=('etc/pam.d/ostrov')
source=('git+https://github.com/ostrov-shell/ostrov.git')
sha256sums=('SKIP')

pkgver() {
  cd ostrov
  git describe --long --tags --abbrev=7 2>/dev/null | sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g' ||
    printf '0.1.0.r%s.g%s' "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
}

prepare() {
  cd ostrov
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd ostrov
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release --workspace
}

check() {
  cd ostrov
  export RUSTUP_TOOLCHAIN=stable
  cargo test --frozen --release --workspace
}

package() {
  cd ostrov
  install -Dm755 target/release/ostrov "$pkgdir/usr/bin/ostrov"
  # xdg-desktop-portal-hyprland's screen-share picker, ostrov run by that name (README.md, Screen sharing)
  ln -s ostrov "$pkgdir/usr/bin/ostrov-share-picker"
  install -Dm644 packaging/pam/ostrov "$pkgdir/etc/pam.d/ostrov"
  install -Dm644 packaging/udev/90-ostrov-battery.rules "$pkgdir/usr/lib/udev/rules.d/90-ostrov-battery.rules"
  install -Dm644 completions/_ostrov "$pkgdir/usr/share/zsh/site-functions/_ostrov"
  install -Dm644 completions/ostrov.bash "$pkgdir/usr/share/bash-completion/completions/ostrov"
  install -Dm644 completions/ostrov.fish "$pkgdir/usr/share/fish/vendor_completions.d/ostrov.fish"
  install -Dm644 -t "$pkgdir/usr/share/doc/ostrov" README.md CHANGELOG.md config/example.toml docs/*.md \
    wit/ostrov-plugin.wit
  install -Dm644 -t "$pkgdir/usr/share/doc/ostrov/examples/widgets" examples/widgets/*
  # the official plugins (plugins/README.md): a binary beside ostrov's, the manifest and texts in
  # /usr/share/ostrov/plugins/ID; hello, the SDK's example, is not one
  for d in plugins/*/; do
    id=$(basename "$d")
    if [ "$id" = hello ] || [ ! -f "$d/manifest.toml" ]; then continue; fi
    install -Dm755 "target/release/ostrov-plugin-$id" -t "$pkgdir/usr/bin"
    install -Dm644 "$d/manifest.toml" -t "$pkgdir/usr/share/ostrov/plugins/$id"
    if [ -d "$d/i18n" ]; then install -Dm644 "$d"/i18n/* -t "$pkgdir/usr/share/ostrov/plugins/$id/i18n"; fi
  done
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
