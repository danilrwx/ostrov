# The battery's charge thresholds writable by the users group, for ostrov's Charge limit (ostrov battery limit N)
SUBSYSTEM=="power_supply", KERNEL=="BAT*", ATTR{charge_control_end_threshold}=="?*", \
  RUN+="/bin/sh -c 'cd /sys%p && chgrp users charge_control_*_threshold && chmod g+w charge_control_*_threshold'"
